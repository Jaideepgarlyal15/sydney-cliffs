{
  "version": "2.0.0",
  "tasks": [
    { "label": "1. Install packages", "type": "shell", "command": "Rscript install.R", "problemMatcher": [] },
    { "label": "2. Run tests", "type": "shell", "command": "Rscript tests/testthat.R", "group": { "kind": "test", "isDefault": true }, "problemMatcher": [] },
    { "label": "3. Demo on synthetic data", "type": "shell", "command": "Rscript scripts/demo_synthetic.R", "problemMatcher": [] },
    { "label": "4. Run pipeline (fast look)", "type": "shell", "command": "Rscript run_all.R --fast", "problemMatcher": [] },
    { "label": "5. Run pipeline (full)", "type": "shell", "command": "Rscript run_all.R", "group": { "kind": "build", "isDefault": true }, "problemMatcher": [] },
    { "label": "6. Render report.html", "type": "shell", "command": "quarto render report.qmd", "problemMatcher": [] },
    { "label": "7. Pre-push audit", "type": "shell", "command": "bash scripts/audit.sh", "problemMatcher": [] }
  ]
}
